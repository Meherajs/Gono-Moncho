# Polygon zkEVM Testnet RPC URL
# Get from: Alchemy, Infura, or use public RPC
POLYGON_ZKEVM_TESTNET_RPC_URL=https://polygonzkevm-cardona.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Your wallet's private key (DO NOT SHARE!)
# Get from: MetaMask → Account Details → Show Private Key
# IMPORTANT: Use a TEST wallet, not your main wallet!
PRIVATE_KEY=your_private_key_here_without_0x

# Polygon API Key for contract verification (optional)
# Get from: https://polygonscan.com/register
POLYGONSCAN_API_KEY=your_polygonscan_api_key
